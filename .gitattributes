# Auto detect text files and perform LF normalization
* text=auto

# JS, JSON and other text files - always use LF
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf
*.vue text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.ts text eol=lf

# Config files
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.env text eol=lf
.env.* text eol=lf
.npmrc text eol=lf
.babelrc text eol=lf
.eslintrc text eol=lf
.prettierrc text eol=lf
package.json text eol=lf
package-lock.json text eol=lf
yarn.lock text eol=lf
moleculer.config.js text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary
*.tar binary
*.rar binary
*.7z binary
*.jar binary
*.war binary
*.ear binary
*.db binary
*.sqlite binary
*.sqlite3 binary